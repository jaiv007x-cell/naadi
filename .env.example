# LLM — vLLM (local GPU) or Ollama fallback
VLLM_URL=http://localhost:8001/v1
VLLM_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
VLLM_API_KEY=EMPTY
HF_TOKEN=

# Legacy OpenAI-compatible (Ollama)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=sk-local
LLM_MODEL=llama3.1:8b
JUDGE_MODEL=llama3.1:8b

# Speech — stub | whisper | xtts | bhashini
SPEECH_MODE=stub
ASR_MODEL=large-v3
ASR_DEVICE=cpu
ASR_COMPUTE=int8
TTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2
TTS_DEVICE=cpu
TTS_SPEAKER_WAV=
BHASHINI_API_KEY=
INDICWHISPER_API_KEY=

# Redis event bus (Dhaara)
REDIS_URL=redis://localhost:6379/0
DHAARA_STREAM_IN=pratibimb.events.in
DHAARA_STREAM_OUT=pratibimb.events.out
DHAARA_GROUP=pratibimb-workers

# Services
PRATIBIMB_HOST=0.0.0.0
PRATIBIMB_PORT=8100
DHAARA_HOST=0.0.0.0
DHAARA_PORT=8200
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
DHAARA_URL=http://localhost:8200
PRATIBIMB_URL=http://localhost:8100

DATABASE_URL=postgresql+asyncpg://naadi:naadi@localhost:5432/naadi
LOG_LEVEL=INFO
